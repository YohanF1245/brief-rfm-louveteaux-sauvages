# Configuration compose local (dev)
ENV_FILE_PATH=.env.dev
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Base Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PUBLIC_PORT=5432

# Base applicative RFM
APP_DB_USER=rfm
APP_DB_PASSWORD=rfm
APP_DB_NAME=rfm
APP_DB_PUBLIC_PORT=5433

# Airflow web/API
AIRFLOW_API_PUBLIC_PORT=8080
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_dev
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Streamlit local
STREAMLIT_PUBLIC_PORT=8501

# Cle fernet pour dev uniquement (placeholder)
FERNET_KEY=change_me_fernet_key

# Lakehouse (MinIO + ClickHouse + Delta)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BROWSER_REDIRECT_URL=https://ymfo1nom.com/deltalake
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Airflow derrière nginx (/airflow)
AIRFLOW_WEBSERVER_BASE_URL=https://ymfo1nom.com/airflow

# Warcraft Logs API (DAG warcraftlogs_guild_nightmares)
# Créer un client sur https://www.warcraftlogs.com/api/docs
# WCL_CLIENT_ID=your_client_id
# WCL_CLIENT_SECRET=your_client_secret
# WCL_GUILD_URL=https://www.warcraftlogs.com/guild/eu/dalaran/nightmares%20asylum
# Logs personnels publics (IDs WCL séparés par virgule — kimahri07=105636)
# WCL_USER_IDS=105636
# WCL_API_SLEEP_SECONDS=0.5
# WCL_MAX_REPORT_PAGES=5
# WCL_INGEST_BATCH_SIZE=50
# WCL_DAG_SCHEDULE=0 */6 * * *

# Optionnel: requirements additionnels au runtime Airflow
_PIP_ADDITIONAL_REQUIREMENTS=openpyxl deltalake pyarrow s3fs
