# Configuration compose local (dev)
ENV_FILE_PATH=.env.dev
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Base Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PUBLIC_PORT=5432

# Base applicative RFM
APP_DB_USER=rfm
APP_DB_PASSWORD=rfm
APP_DB_NAME=rfm
APP_DB_PUBLIC_PORT=5433

# Airflow web/API
AIRFLOW_API_PUBLIC_PORT=8080
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_dev
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Streamlit local
STREAMLIT_PUBLIC_PORT=8501

# Cle fernet pour dev uniquement (placeholder)
FERNET_KEY=change_me_fernet_key

# Lakehouse (MinIO + ClickHouse + Delta)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BROWSER_REDIRECT_URL=https://ymfo1nom.com/deltalake
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
# Auth HTTP /play — user default + CLICKHOUSE_PASSWORD (.env, sans guillemets)
# Setup Play : clickhouse/queries/00_setup_play_ui.sql (GRANT minio_lake)
CLICKHOUSE_PASSWORD=change_me_clickhouse_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Airflow derrière nginx (/airflow)
AIRFLOW_WEBSERVER_BASE_URL=https://ymfo1nom.com/airflow

# Warcraft Logs (DAG warcraftlogs_guild_nightmares) — prod : Airflow UI
# Flux : API → Delta MinIO → ClickHouse (pas de Postgres)
# Connection WCL_API (HTTP) : Login=client_id, Password=client_secret
# Variables : wcl_guild_url, wcl_user_ids (ex. 105636), wcl_ingest_batch_size (50)
# Dev local script uniquement :
# WCL_CLIENT_ID=your_client_id
# WCL_CLIENT_SECRET=your_client_secret

# Optionnel: requirements additionnels au runtime Airflow
_PIP_ADDITIONAL_REQUIREMENTS=openpyxl deltalake pyarrow s3fs
